# Coyoteville environment variables
# Copy this file to .env.local for local work. Never commit .env.local.

# Public base URL, no trailing slash. Used for canonical tags, Open Graph, the
# sitemap, the Square redirect URL and the webhook notification URL that the
# signature is computed against.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Project URL is public. The service role key is not, it bypasses
# row level security and is only ever read inside server route handlers.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Square. Use a sandbox token and sandbox location while testing.
# SQUARE_ENVIRONMENT must be exactly 'production' to hit live Square. Anything
# else resolves to sandbox, so a typo cannot charge a real card.
SQUARE_ACCESS_TOKEN=your-square-access-token
SQUARE_LOCATION_ID=your-square-location-id
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=your-webhook-signature-key

# Admin tracker at /admin. Any non empty value turns the page on; pick
# something long. The session cookie is an HMAC keyed by this value, so
# changing it signs everyone out.
ADMIN_PASSWORD=pick-a-long-random-password

# Hidden prepaid vendor registration at /r/<token>.
# The token is the whole credential, so make it long and random. Anything that
# does not match returns a real 404.
PREPAID_ACCESS_TOKEN=generate-a-long-random-string

# Two gates behind the link, both enforced server side.
# Expiry: ISO timestamp. Nothing is accepted after it. An unreadable value is
# treated as expired, which fails closed.
PREPAID_LINK_EXPIRES_AT=2026-08-27T23:59:59-05:00
# Cap: how many offline registrations the current event will take. Counted from
# rows with payment_method = 'offline'.
PREPAID_MAX_REGISTRATIONS=20

# Resend, for registration email. The FROM_EMAIL domain has to be verified in
# Resend or sends fail silently, so use an address on a domain you control.
RESEND_API_KEY=re_your_api_key
FROM_EMAIL=Coyoteville <vendors@coyoteville.com>
