# Coyoteville environment variables
# Copy this file to .env.local for local work. Never commit .env.local.

# Public base URL, no trailing slash. Used for canonical tags, Open Graph, the
# sitemap, the Square redirect URL and the webhook notification URL that the
# signature is computed against.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Project URL is public. The service role key is not, it bypasses
# row level security and is only ever read inside server route handlers.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Square. Use a sandbox token and sandbox location while testing.
# SQUARE_ENVIRONMENT must be exactly 'production' to hit live Square. Anything
# else resolves to sandbox, so a typo cannot charge a real card.
SQUARE_ACCESS_TOKEN=your-square-access-token
SQUARE_LOCATION_ID=your-square-location-id
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=your-webhook-signature-key

# --- Recurring monthly spots -------------------------------------------------
# The permanent spot is a real Square subscription with a card on file, which
# needs three things the one-off checkout did not.
#
# 1. The browser has to tokenise the card, so the Web Payments SDK needs the
#    application id and the location id IN THE PAGE. Both are public
#    identifiers and are safe to expose; the access token above is not and
#    never leaves the server. NEXT_PUBLIC_SQUARE_LOCATION_ID is the same value
#    as SQUARE_LOCATION_ID, duplicated because only NEXT_PUBLIC_ variables are
#    inlined into the client bundle.
NEXT_PUBLIC_SQUARE_APPLICATION_ID=sq0idp-your-application-id
NEXT_PUBLIC_SQUARE_LOCATION_ID=your-square-location-id
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox
#
# 2. One subscription plan variation per spot type, created by hand in the
#    Square dashboard under Items then Subscription Plans. Deliberately not
#    created from code: a catalog object made by a deploy is one nobody can
#    find when the price needs changing. Set them to $600 and $350 monthly.
SQUARE_MONTHLY_TRUCK_PLAN_VARIATION_ID=your-truck-plan-variation-id
SQUARE_MONTHLY_BOOTH_PLAN_VARIATION_ID=your-booth-plan-variation-id
#
# 3. The webhook subscription in the Square dashboard needs these events added
#    alongside payment.updated, or renewals and failures go unnoticed:
#      invoice.payment_made
#      invoice.scheduled_charge_failed
#      invoice.updated
#      subscription.updated

# Admin tracker at /admin. Any non empty value turns the page on; pick
# something long. The session cookie is an HMAC keyed by this value, so
# changing it signs everyone out.
ADMIN_PASSWORD=pick-a-long-random-password

# The prepaid registration link is gone. PREPAID_ACCESS_TOKEN,
# PREPAID_LINK_EXPIRES_AT and PREPAID_MAX_REGISTRATIONS are no longer read by
# anything and can be deleted from the deployment. Removing them switches
# nothing off, because there is no longer a route to switch off, and setting
# them again switches nothing back on.

# Public contact address. Shown on the site, in the FAQ, in the JSON-LD and in
# the vendor confirmation email. Defaults to support@coyoteville.com.
# New vendor alerts go to ceo@36west.org instead, which is set in lib/seo.ts as
# SITE.ownerEmail and is never rendered publicly.
SUPPORT_EMAIL=support@coyoteville.com

# Resend, for registration email. The FROM_EMAIL domain has to be verified in
# Resend or sends fail silently, so use an address on a domain you control.
RESEND_API_KEY=re_your_api_key
FROM_EMAIL=Coyoteville <vendors@coyoteville.com>
