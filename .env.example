# Coyoteville environment variables
# Copy this file to .env.local for local work. Never commit .env.local.

# Public base URL, no trailing slash. Used for canonical tags, Open Graph,
# the sitemap and Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Project URL is public. The service role key is not, it bypasses
# row level security and is only ever read inside server route handlers.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe. Use test keys locally, live keys in production.
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
